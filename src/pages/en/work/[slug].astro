---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { content, projects, type ProjectSlug } from '../../../data/content'
export function getStaticPaths() {
  return projects.map((slug) => ({ params: { slug }, props: { slug } }))
}
const lang = 'en'
const copy = content[lang]
const { slug } = Astro.props as { slug: ProjectSlug }
const project = copy.cases[slug]
---
<BaseLayout title={`${project.title} — ${project.category}`} description={project.description} lang={lang}>
  <main id="main">
    <section class="case-hero"><div class="container-shell"><a class="back-link" href="/en/work">← Back to selected work</a><span class="eyebrow">{project.category}</span><h1 class="display-title">{project.title}</h1><p class="lead">{project.description}</p><div class="case-role"><span>MY CONTRIBUTION</span><strong>{project.role}</strong></div></div></section>
    <section class="section-space"><div class="container-shell detail-grid"><div><span class="eyebrow">CONTEXT</span><h2>Contributing to real-world technology challenges.</h2></div><div><h3>About the project</h3><p>{project.description}</p><h3>My contribution</h3><p>{project.contribution}</p><p class="disclosure-note">Out of respect for confidentiality and each engagement’s scope, additional implementation details and results are shared when authorized.</p><a href="/en/contact" class="button-primary">Discuss a challenge <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
</BaseLayout>
<style>
.case-hero { padding-block:32px 70px; }
.back-link { display:inline-block; margin-bottom:58px; color:var(--muted); font-size:12px; font-weight:650; }
.case-hero h1 { margin-top:16px; }
.case-hero .lead { max-width:720px; margin-top:24px; }
.case-role { display:grid; gap:7px; width:fit-content; margin-top:36px; border-left:2px solid var(--green); padding:4px 0 4px 16px; }
.case-role span { color:var(--muted); font-size:9px; font-weight:800; letter-spacing:.15em; }
.case-role strong { font-size:13px; font-weight:700; }
.detail-grid { display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(35px,8vw,110px); border-top:1px solid var(--line); padding-top:50px; }
.detail-grid h2 { margin:18px 0; font-size:clamp(29px,3.6vw,43px); line-height:1.1; letter-spacing:-.055em; }
.detail-grid h3 { margin:0 0 8px; font-size:17px; letter-spacing:-.03em; }
.detail-grid p { margin:0 0 28px; color:var(--muted); font-size:14px; line-height:1.85; }
.detail-grid .disclosure-note { padding:17px 18px; border-left:2px solid #c5d5c7; background:#eef2eb; font-size:12px; }
@media(max-width:700px) { .detail-grid { grid-template-columns:1fr; } .back-link { margin-bottom:40px; } }
</style>
