---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { content } from '../../data/content'
const lang = 'pt-BR'
const copy = content[lang]
const projects = ['eficaz', 'traain', 'fatima', 'pedbot'] as const
---
<BaseLayout title="Projetos selecionados" description="Experiência em consultoria de tecnologia, SaaS com IA, desenvolvimento de software e análise de infraestrutura." lang={lang}>
  <main id="main">
    <section class="page-hero"><div class="container-shell"><span class="eyebrow">PROJETOS SELECIONADOS</span><h1 class="display-title">Experiência construída em <em>problemas reais.</em></h1><p class="lead">Cada projeto representa um contexto diferente e uma forma específica de contribuir — com responsabilidades apresentadas de forma clara.</p></div></section>
    <section class="section-space"><div class="container-shell"><div class="projects-grid">{projects.map((slug) => <ProjectCard slug={slug} project={copy.cases[slug]} lang={lang} />)}</div><p class="portfolio-note">As descrições resumem os tipos de produto e minha atuação em cada contexto. Detalhes de arquitetura, clientes e resultados são compartilhados apenas quando podem ser divulgados.</p></div></section>
  </main>
</BaseLayout>
<style>
.page-hero { padding-block:clamp(70px,9vw,120px) 48px; }
.page-hero h1 { max-width:850px; }
.page-hero p { max-width:700px; margin-top:24px; }
.projects-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
.portfolio-note { margin:28px 0 0; border-top:1px solid var(--line); padding-top:22px; color:var(--muted); font-size:12px; line-height:1.75; }
@media(max-width:650px) { .projects-grid { grid-template-columns:1fr; } }
</style>
