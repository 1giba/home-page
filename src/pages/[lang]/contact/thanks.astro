---
// Confirmation after a form submission: not for search results (SPEC §5.2), hence noindex.
import PlaceholderPage from '@/components/PlaceholderPage.astro'
import type { Locale } from '@/i18n/locales'
import { useTranslations } from '@/i18n/ui'
import { localeStaticPaths } from '@/lib/routes'

export const getStaticPaths = localeStaticPaths

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
---

<PlaceholderPage
  locale={locale}
  path="/contact/thanks/"
  noindex
  heading={t('page.thanks')}
  title={t('meta.thanks.title')}
  description={t('meta.thanks.description')}
/>
