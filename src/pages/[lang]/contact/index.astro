---
// Contact (SPEC §5.2, plan F5-03): the intro call first (primary CTA, Q-11 default), then the
// form, direct email and the one confirmed FAQ answer. No "available for projects" indicator.
import PageIntro from '@/components/arcade/PageIntro.astro'
import ContactForm from '@/components/ContactForm.astro'
import Container from '@/components/ui/Container.astro'
import LinkButton from '@/components/ui/LinkButton.astro'
import { CALENDLY_URL, CONTACT_EMAIL } from '@/config/site'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Locale } from '@/i18n/locales'
import { useTranslations } from '@/i18n/ui'
import { localeStaticPaths } from '@/lib/routes'

export const getStaticPaths = localeStaticPaths

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
const h2 = 'text-2xl'
---

<BaseLayout
  locale={locale}
  path="/contact/"
  title={t('meta.contact.title')}
  description={t('meta.contact.description')}
>
  <PageIntro>
    <h1 class="text-3xl">{t('contact.title')}</h1>
    <p class="mt-4 max-w-prose text-lg text-on-night-muted">{t('contact.lead')}</p>
  </PageIntro>
  <Container class="py-16">
    <div class="flex max-w-prose flex-col gap-16">
      <section data-section="call" aria-labelledby="call" class="pixel-box m-1 bg-pale p-6 md:p-8">
        <h2 id="call" class={h2}>
          {t('contact.call')}
        </h2>
        <p class="mt-3">{t('contact.callText')}</p>
        <LinkButton
          href={CALENDLY_URL}
          variant="primary"
          externalLabel={t('a11y.external')}
          class="mt-5"
        >
          {t('cta.book')}
        </LinkButton>
      </section>

      <section data-section="message" aria-labelledby="message-heading">
        <h2 id="message-heading" class={h2}>
          {t('cta.message')}
        </h2>
        <p class="mt-3">{t('contact.messageText')}</p>
        <div class="mt-6">
          <ContactForm locale={locale} />
        </div>
      </section>

      <section data-section="email" aria-labelledby="email-heading">
        <h2 id="email-heading" class={h2}>
          {t('contact.email')}
        </h2>
        <p class="mt-3">{t('contact.emailText')}</p>
        <p class="mt-2">
          <a href={`mailto:${CONTACT_EMAIL}`} class="inline-block max-w-full py-1 wrap-anywhere">
            {CONTACT_EMAIL}
          </a>
        </p>
      </section>

      <section data-section="faq" aria-labelledby="faq">
        <h2 id="faq" class={h2}>
          {t('contact.faq')}
        </h2>
        <h3 class="mt-6 font-semibold">{t('contact.faq.budget')}</h3>
        <p class="mt-2">{t('contact.faq.budgetAnswer')}</p>
      </section>
    </div>
  </Container>
</BaseLayout>
