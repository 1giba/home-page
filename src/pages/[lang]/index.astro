---
// Home (SPEC §5.2): hero → problems → services → evidence → how an engagement starts → closing.
import CaseCard from '@/components/CaseCard.astro'
import EngagementSteps from '@/components/EngagementSteps.astro'
import FounderEvidence from '@/components/FounderEvidence.astro'
import ServiceCard from '@/components/ServiceCard.astro'
import Container from '@/components/ui/Container.astro'
import LinkButton from '@/components/ui/LinkButton.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { CALENDLY_URL } from '@/config/site'
import type { Locale } from '@/i18n/locales'
import { localizedPath } from '@/i18n/paths'
import { useTranslations } from '@/i18n/ui'
import { getPublishedProjects, getServices } from '@/lib/content'
import { localeStaticPaths } from '@/lib/routes'

export const getStaticPaths = localeStaticPaths

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
const services = await getServices(locale)
const work = await getPublishedProjects(locale)
const problems = ['1', '2', '3', '4', '5'] as const
const h2 = 'text-2xl font-semibold tracking-tight'
---

<BaseLayout
  locale={locale}
  path="/"
  title={t('meta.home.title')}
  description={t('meta.home.description')}
>
  <section data-section="hero" class="border-b border-border">
    <Container class="py-20 md:py-28">
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight">{t('home.h1')}</h1>
      <p class="mt-6 max-w-prose text-lg text-muted">{t('home.lead')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <LinkButton href={CALENDLY_URL} variant="primary" externalLabel={t('a11y.external')}>
          {t('cta.book')}
        </LinkButton>
        <LinkButton href={localizedPath(locale, '/services/')} variant="secondary">
          {t('cta.services')}
        </LinkButton>
      </div>
    </Container>
  </section>

  <section data-section="problems" aria-labelledby="problems">
    <Container class="py-16">
      <h2 id="problems" class={h2}>
        {t('home.problems')}
      </h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {problems.map((n) => (
          <li class="border-l-2 border-accent pl-4">{t(`home.problem.${n}`)}</li>
        ))}
      </ul>
    </Container>
  </section>

  <section data-section="services" aria-labelledby="services" class="bg-surface">
    <Container class="py-16">
      <h2 id="services" class={h2}>
        {t('home.services')}
      </h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {services.map(({ id, entry: { data } }) => (
          <ServiceCard
            locale={locale}
            id={id}
            title={data.title}
            summary={data.summary}
            audience={data.audience[0]}
          />
        ))}
      </div>
    </Container>
  </section>

  <section data-section="evidence" aria-labelledby="evidence">
    <Container class="py-16">
      {work.length > 0 ? (
        <>
          <h2 id="evidence" class={h2}>
            {t('home.work')}
          </h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {work.map((p) => (
              <CaseCard locale={locale} id={p.id} project={p.entry.data} headingLevel="h3" />
            ))}
          </div>
        </>
      ) : (
        <>
          <h2 id="evidence" class={h2}>
            {t('home.evidence')}
          </h2>
          <div class="mt-6">
            <FounderEvidence locale={locale} />
          </div>
        </>
      )}
    </Container>
  </section>

  <section data-section="steps" aria-labelledby="steps" class="bg-surface">
    <Container class="py-16">
      <h2 id="steps" class={h2}>
        {t('home.steps')}
      </h2>
      <div class="mt-8">
        <EngagementSteps locale={locale} />
      </div>
    </Container>
  </section>

  <section data-section="closing" aria-labelledby="closing">
    <Container class="py-16">
      <h2 id="closing" class={h2}>
        {t('home.closing')}
      </h2>
      <p class="mt-3 max-w-prose">{t('home.closing.text')}</p>
      <LinkButton href={localizedPath(locale, '/contact/')} variant="primary" class="mt-6">
        {t('cta.message')}
      </LinkButton>
    </Container>
  </section>
</BaseLayout>
