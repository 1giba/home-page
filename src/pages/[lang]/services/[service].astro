---
import PlaceholderPage from '@/components/PlaceholderPage.astro'
import { LOCALES, type Locale } from '@/i18n/locales'
import { useTranslations } from '@/i18n/ui'
import { SERVICE_IDS, type ServiceId } from '@/lib/routes'

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    SERVICE_IDS.map((service) => ({
      params: { lang, service },
      props: { locale: lang, service },
    }))
  )
}

interface Props {
  locale: Locale
  service: ServiceId
}
const { locale, service } = Astro.props
const t = useTranslations(locale)
---

<PlaceholderPage
  locale={locale}
  path={`/services/${service}/`}
  heading={t(`service.${service}`)}
  title={t(`meta.service.${service}.title`)}
  description={t(`meta.service.${service}.description`)}
/>
