---
// Selected work. Built only when at least one case study is published (SPEC §4.5); otherwise
// getStaticPaths returns nothing and no page exists.
import PageIntro from '@/components/arcade/PageIntro.astro'
import CaseCard from '@/components/CaseCard.astro'
import Container from '@/components/ui/Container.astro'
import LinkButton from '@/components/ui/LinkButton.astro'
import { CALENDLY_URL } from '@/config/site'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Locale } from '@/i18n/locales'
import { useTranslations } from '@/i18n/ui'
import { getPublishedProjects, hasPublishedWork } from '@/lib/content'
import { localeStaticPaths } from '@/lib/routes'

export async function getStaticPaths() {
  return (await hasPublishedWork()) ? localeStaticPaths() : []
}

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
const projects = await getPublishedProjects(locale)
---

<BaseLayout
  locale={locale}
  path="/work/"
  title={t('meta.work.title')}
  description={t('meta.work.description')}
>
  <PageIntro>
    <h1 class="text-3xl">{t('work.title')}</h1>
    <p class="mt-4 max-w-prose text-lg text-on-night-muted">{t('work.intro')}</p>
  </PageIntro>
  <Container class="py-16">
    <div class="grid gap-8 md:grid-cols-2">
      {projects.map(({ id, entry }) => (
        <CaseCard locale={locale} id={id} project={entry.data} />
      ))}
    </div>
    <LinkButton
      href={CALENDLY_URL}
      variant="primary"
      externalLabel={t('a11y.external')}
      class="mt-12"
    >
      {t('cta.book')}
    </LinkButton>
  </Container>
</BaseLayout>
