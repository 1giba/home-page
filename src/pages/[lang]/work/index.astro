---
// Selected work. Built only when at least one case study is published (SPEC §4.5); otherwise
// getStaticPaths returns nothing and no page exists.
import CaseCard from '@/components/CaseCard.astro'
import Container from '@/components/ui/Container.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Locale } from '@/i18n/locales'
import { useTranslations } from '@/i18n/ui'
import { getPublishedProjects, hasPublishedWork } from '@/lib/content'
import { localeStaticPaths } from '@/lib/routes'

export async function getStaticPaths() {
  return (await hasPublishedWork()) ? localeStaticPaths() : []
}

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
const projects = await getPublishedProjects(locale)
---

<BaseLayout
  locale={locale}
  path="/work/"
  title={t('meta.work.title')}
  description={t('meta.work.description')}
>
  <Container class="py-16">
    <h1 class="text-3xl font-semibold tracking-tight">{t('work.title')}</h1>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {projects.map(({ id, entry }) => (
        <CaseCard locale={locale} id={id} project={entry.data} />
      ))}
    </div>
  </Container>
</BaseLayout>
