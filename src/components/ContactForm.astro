---
// Contact form (SPEC §13.2–§13.4). A native POST to FormSubmit that works without JavaScript and
// lands on the localized thanks page; the fields are exactly those disclosed in Privacy §1.
// src/scripts/contact-form.ts enhances it (plan F5-02); its copy comes from data-options and the
// two templates below, so the script holds no text of its own.
import type { Locale } from '@/i18n/locales'
import { absoluteUrl, localizedPath } from '@/i18n/paths'
import { useTranslations } from '@/i18n/ui'
import LinkButton from '@/components/ui/LinkButton.astro'
import { CALENDLY_URL, CONTACT_EMAIL, FORMSUBMIT_ACTION, FORMSUBMIT_AJAX } from '@/config/site'
import { SERVICE_IDS } from '@/lib/routes'

export interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)

const label = 'block font-semibold'
const field =
  'mt-2 block w-full min-h-11 rounded-base border border-muted bg-bg px-3 py-2 text-base text-text'
const error = 'mt-2 text-sm text-error'

const options = {
  ajaxUrl: FORMSUBMIT_AJAX,
  messages: {
    sending: t('form.sending'),
    required: t('form.error.required'),
    email: t('form.error.email'),
    minlength: t('form.error.minlength'),
    maxlength: t('form.error.maxlength'),
  },
}
---

<div data-contact>
  <form
    method="POST"
    action={FORMSUBMIT_ACTION}
    data-contact-form
    data-options={JSON.stringify(options)}
    class="flex max-w-prose flex-col gap-6"
  >
    <input type="hidden" name="_subject" value={t('form.emailSubject')} />
    <input
      type="hidden"
      name="_next"
      value={absoluteUrl(localizedPath(locale, '/contact/thanks/'))}
    />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_template" value="table" />
    <input
      type="text"
      name="_honey"
      class="sr-only"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div>
      <label for="name" class={label}>
        {t('form.name')} <span class="font-normal text-muted">{t('form.required')}</span>
      </label>
      <input
        id="name"
        name="name"
        type="text"
        required
        minlength="2"
        autocomplete="name"
        aria-describedby="name-error"
        class={field}
      />
      <p id="name-error" class={error} hidden></p>
    </div>

    <div>
      <label for="email" class={label}>
        {t('form.email')} <span class="font-normal text-muted">{t('form.required')}</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        aria-describedby="email-error"
        class={field}
      />
      <p id="email-error" class={error} hidden></p>
    </div>

    <div>
      <label for="company" class={label}>
        {t('form.company')} <span class="font-normal text-muted">{t('form.optional')}</span>
      </label>
      <input
        id="company"
        name="company"
        type="text"
        autocomplete="organization"
        aria-describedby="company-error"
        class={field}
      />
      <p id="company-error" class={error} hidden></p>
    </div>

    <div>
      <label for="service" class={label}>
        {t('form.service')} <span class="font-normal text-muted">{t('form.required')}</span>
      </label>
      <select id="service" name="service" required aria-describedby="service-error" class={field}>
        {SERVICE_IDS.map((id) => (
          <option value={id}>{t(`service.${id}`)}</option>
        ))}
        <option value="other" selected>
          {t('form.service.other')}
        </option>
      </select>
      <p id="service-error" class={error} hidden></p>
    </div>

    <div>
      <label for="message" class={label}>
        {t('form.message')} <span class="font-normal text-muted">{t('form.required')}</span>
      </label>
      <p id="message-hint" class="mt-1 text-sm text-muted">
        {t('form.messageHint')}
      </p>
      <textarea
        id="message"
        name="message"
        required
        minlength="10"
        maxlength="5000"
        rows="6"
        aria-describedby="message-hint message-error"
        class={field}
      ></textarea>
      <p id="message-error" class={error} hidden></p>
    </div>

    <p data-privacy-notice class="text-sm text-muted">
      {t('form.privacy')}{' '}
      <a href={localizedPath(locale, '/privacy/')} class="inline-block py-1">
        {t('form.privacyLink')}
      </a>
    </p>

    <div role="status" aria-live="polite" data-form-status></div>

    <div>
      <button
        type="submit"
        class="inline-flex min-h-11 items-center justify-center rounded-base bg-accent px-4 py-2 text-sm font-semibold text-on-accent transition-colors duration-150 hover:bg-accent-hover"
      >
        {t('form.submit')}
      </button>
    </div>
  </form>

  <template data-success>
    <div data-contact-success class="max-w-prose">
      <h2 tabindex="-1" class="text-2xl font-semibold tracking-tight">
        {t('page.thanks')}
      </h2>
      <p class="mt-3">{t('thanks.text')}</p>
      <p class="mt-6">{t('thanks.call')}</p>
      <LinkButton
        href={CALENDLY_URL}
        variant="primary"
        externalLabel={t('a11y.external')}
        class="mt-4"
      >
        {t('cta.book')}
      </LinkButton>
    </div>
  </template>

  <template data-failure>
    <p class="text-error">
      {t('form.failure')}{' '}
      <a href={`mailto:${CONTACT_EMAIL}`} class="wrap-anywhere">
        {CONTACT_EMAIL}
      </a>
    </p>
  </template>
</div>

<script>
  import { initContactForm } from '@/scripts/contact-form'

  for (const root of document.querySelectorAll<HTMLElement>('[data-contact]')) {
    const form = root.querySelector<HTMLFormElement>('form[data-contact-form]')!
    initContactForm(form, {
      ...JSON.parse(form.dataset.options!),
      success: root.querySelector<HTMLTemplateElement>('template[data-success]')!,
      failure: root.querySelector<HTMLTemplateElement>('template[data-failure]')!,
    })
  }
</script>
