---
const { service } = Astro.props
---
<article class="service-card">
  <div class="service-number">{service.number}</div>
  <h3>{service.title}</h3>
  <p>{service.description}</p>
  <ul>{service.bullets.map((item) => <li><span aria-hidden="true">↗</span>{item}</li>)}</ul>
</article>
<style>
  .service-card { min-height:100%; padding:28px; border:1px solid var(--line); border-radius:20px; background:#fff; transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease; }
  .service-card:hover { transform:translateY(-4px); border-color:#bacfc2; box-shadow:0 16px 45px rgba(20,33,31,.055); }
  .service-number { display:grid; width:42px; height:42px; place-items:center; border:1px solid var(--line); border-radius:13px; color:var(--green); font-size:12px; font-weight:800; }
  h3 { margin:24px 0 11px; font-size:22px; font-weight:650; letter-spacing:-.045em; line-height:1.2; }
  p { margin:0; color:var(--muted); font-size:14px; line-height:1.75; }
  ul { display:grid; gap:12px; margin:23px 0 0; padding:20px 0 0; border-top:1px solid #edf0ed; list-style:none; }
  li { display:flex; gap:10px; color:#33443e; font-size:12px; line-height:1.5; }
  li span { color:var(--green); }
</style>
