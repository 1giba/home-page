---
// Typography for rendered Markdown (About, legal pages), in the design tokens.
---

<div class="prose max-w-prose">
  <slot />
</div>

<style>
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1rem;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .prose :global(li + li) {
    margin-top: 0.5rem;
  }
  .prose :global(h2) {
    margin-top: 3rem;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    font-weight: 600;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
</style>
