---
// A decorative pixel-art icon (aria-hidden): one <rect> per horizontal run of a colour in the
// grid, with crisp edges so it stays sharp at any whole-pixel scale. Colours come from the .px-*
// classes in global.css. `mono` paints every pixel with currentColor (e.g. arrows in links).
import { PIXEL_ICONS, type PixelIconName } from './pixel-icons'

export interface Props {
  name: PixelIconName
  class?: string
  mono?: boolean
}
const { name, class: className = 'size-10', mono = false } = Astro.props
const grid = PIXEL_ICONS[name]
const width = Math.max(...grid.map((row) => row.length))

const runs: { x: number; y: number; w: number; c: string }[] = []
grid.forEach((row, y) => {
  let x = 0
  while (x < row.length) {
    const c = row[x]
    let end = x + 1
    while (end < row.length && row[end] === c) end++
    if (c !== '.') runs.push({ x, y, w: end - x, c })
    x = end
  }
})
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${grid.length}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {runs.map(({ x, y, w, c }) =>
    mono ? (
      <rect x={x} y={y} width={w} height="1" fill="currentColor" />
    ) : (
      <rect x={x} y={y} width={w} height="1" class={`px-${c}`} />
    )
  )}
</svg>
