---
// A link styled as a button (navigation, not an action). Opens in the same tab (SPEC §6.2).
// Height is at least 44px so it meets the primary-control target size (SPEC §6.3).
// `externalLabel` marks an off-site destination with an icon and screen-reader text (SPEC §7.3).
import Icon from '@/components/ui/Icon.astro'

export interface Props {
  href: string
  variant: 'primary' | 'secondary'
  externalLabel?: string
  class?: string
}
const { href, variant, externalLabel, class: className } = Astro.props
---

<a
  href={href}
  data-cta={variant}
  class:list={[
    'inline-flex min-h-11 items-center justify-center gap-2 rounded-base px-4 py-2 text-center text-sm font-semibold no-underline transition-colors duration-150',
    variant === 'primary'
      ? 'bg-accent text-on-accent hover:bg-accent-hover hover:text-on-accent'
      : 'border border-text text-text hover:bg-surface hover:text-text',
    className,
  ]}
>
  <slot />
  {externalLabel && (
    <>
      <Icon name="external" class="size-4 shrink-0" />
      <span class="sr-only">{externalLabel}</span>
    </>
  )}
</a>
