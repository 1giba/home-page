---
// Static (non-sticky) header, so it can never cover a focused element (WCAG 2.2 SC 2.4.11).
// Desktop (≥ lg): inline nav, language switcher and booking CTA. Below lg: a <details> toggle in
// the bar and the menu panel as a full-width row beneath it (in normal flow, so opening it pushes
// the page down instead of covering it). The bar wraps rather than overflowing at large text sizes.
import Container from '@/components/ui/Container.astro'
import Icon from '@/components/ui/Icon.astro'
import LinkButton from '@/components/ui/LinkButton.astro'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import MobileNav from '@/components/MobileNav.astro'
import { CALENDLY_URL } from '@/config/site'
import type { Locale } from '@/i18n/locales'
import { localizedPath } from '@/i18n/paths'
import { useTranslations } from '@/i18n/ui'
import { ariaCurrent, mainNav } from '@/lib/navigation'

export interface Props {
  locale: Locale
  showWork: boolean
  showLanguageSwitcher: boolean
}
const { locale, showWork, showLanguageSwitcher } = Astro.props
const t = useTranslations(locale)
const items = mainNav(locale, showWork)
---

<header class="border-t-[3px] border-b border-t-accent border-b-border bg-bg">
  <Container class="flex min-h-16 flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2">
    <a
      href={localizedPath(locale, '/')}
      class="text-lg font-semibold tracking-tight whitespace-nowrap text-text no-underline hover:text-text"
    >
      Code Happy
    </a>

    <div data-desktop-nav class="hidden flex-wrap items-center justify-end gap-x-6 gap-y-2 lg:flex">
      <nav aria-label={t('nav.label')}>
        <ul class="flex flex-wrap items-center gap-1">
          {items.map((item) => {
            const current = ariaCurrent(Astro.url.pathname, item.href)
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={current}
                  class:list={[
                    'inline-block rounded-base px-3 py-2 text-sm font-medium text-text no-underline hover:text-accent',
                    current && 'underline decoration-accent decoration-2 underline-offset-8',
                  ]}
                >
                  {t(item.key)}
                </a>
              </li>
            )
          })}
        </ul>
      </nav>
      {showLanguageSwitcher && <LanguageSwitcher locale={locale} />}
      <LinkButton href={CALENDLY_URL} variant="primary" externalLabel={t('a11y.external')}>
        {t('cta.book')}
      </LinkButton>
    </div>

    <details data-menu class="lg:hidden">
      <summary
        aria-controls="mobile-menu"
        class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-base border border-border px-3 text-sm font-medium [&::-webkit-details-marker]:hidden"
      >
        <Icon name="menu" />
        {t('nav.menu')}
      </summary>
    </details>
  </Container>

  <div id="mobile-menu" data-mobile-panel class="border-t border-border lg:hidden">
    <MobileNav locale={locale} items={items} showLanguageSwitcher={showLanguageSwitcher} />
  </div>
</header>

<style>
  /* No-JS disclosure: the panel follows the <details> state. */
  header:has(details[data-menu]:not([open])) [data-mobile-panel] {
    display: none;
  }

  /* Without :has() the panel cannot be hidden, so it stays visible as plain navigation and the
     toggle is removed; otherwise it would announce "collapsed" while the menu is shown. */
  @supports not selector(:has(*)) {
    details[data-menu] {
      display: none;
    }
  }
</style>
