---
import { Image } from 'astro:assets'
import logo from '@/assets/brand/logo/code-happy-logo-on-dark.svg'
import Container from '@/components/ui/Container.astro'
import Icon from '@/components/ui/Icon.astro'
import { CONTACT_EMAIL, LEGAL_NAME, SOCIAL } from '@/config/site'
import type { Locale } from '@/i18n/locales'
import { localizedPath } from '@/i18n/paths'
import { useTranslations } from '@/i18n/ui'
import { mainNav } from '@/lib/navigation'

export interface Props {
  locale: Locale
  showWork: boolean
}
const { locale, showWork } = Astro.props
const t = useTranslations(locale)

const socials = [
  { name: 'GitHub', href: SOCIAL.github, icon: 'github' },
  { name: 'LinkedIn', href: SOCIAL.linkedin, icon: 'linkedin' },
  { name: 'X', href: SOCIAL.x, icon: 'x' },
] as const

const linkClass = 'inline-block py-1 text-on-night-muted no-underline hover:underline'
---

<footer class="surface-night text-sm">
  {/* A pixel skyline edge joins the footer to the page above it. */}
  <div
    aria-hidden="true"
    class="h-3 bg-[linear-gradient(90deg,var(--color-px-blue)_0_25%,var(--color-px-pink)_25%_50%,var(--color-px-yellow)_50%_75%,var(--color-px-green)_75%)] bg-size-[64px_100%]"
  ></div>
  <Container class="grid gap-10 py-12 md:grid-cols-3">
    <div>
      {/* The on-dark logo (white wordmark, white icon outline) on the night surface. */}
      <Image src={logo} alt="Code Happy" height={44} class="block h-11 w-auto" />
      <p class="mt-4 max-w-xs text-on-night-muted">{t('footer.tagline')}</p>
    </div>

    <nav aria-label={t('footer.nav')}>
      <ul class="flex flex-col gap-1">
        {mainNav(locale, showWork).map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <a href={`mailto:${CONTACT_EMAIL}`} class="inline-block py-1 wrap-anywhere">
        {CONTACT_EMAIL}
      </a>
      <ul aria-label={t('footer.social')} class="mt-3 -ml-3 flex gap-1">
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              aria-label={social.name}
              class="flex size-11 items-center justify-center rounded-base text-on-night-muted"
            >
              <Icon name={social.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>

  <div class="border-t border-night-line">
    <Container class="flex flex-col gap-2 py-6 text-on-night-muted sm:flex-row sm:items-center sm:justify-between">
      <p>
        © 2020–{new Date().getFullYear()} {LEGAL_NAME} {t('footer.rights')}
      </p>
      <ul class="flex gap-4">
        <li>
          <a href={localizedPath(locale, '/privacy/')} class={linkClass}>
            {t('footer.privacy')}
          </a>
        </li>
      </ul>
    </Container>
  </div>
</footer>
