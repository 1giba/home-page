---
import Container from '@/components/ui/Container.astro'
import Icon from '@/components/ui/Icon.astro'
import { CONTACT_EMAIL, LEGAL_NAME, SOCIAL } from '@/config/site'
import type { Locale } from '@/i18n/locales'
import { localizedPath } from '@/i18n/paths'
import { useTranslations } from '@/i18n/ui'
import { mainNav } from '@/lib/navigation'

export interface Props {
  locale: Locale
  showWork: boolean
}
const { locale, showWork } = Astro.props
const t = useTranslations(locale)

const socials = [
  { name: 'GitHub', href: SOCIAL.github, icon: 'github' },
  { name: 'LinkedIn', href: SOCIAL.linkedin, icon: 'linkedin' },
  { name: 'X', href: SOCIAL.x, icon: 'x' },
] as const

const linkClass = 'inline-block py-1 text-muted no-underline hover:text-accent hover:underline'
---

<footer class="border-t border-border bg-surface text-sm">
  <Container class="grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="text-base font-semibold tracking-tight text-text">Code Happy</p>
      <p class="mt-2 max-w-xs text-muted">{t('footer.tagline')}</p>
    </div>

    <nav aria-label={t('footer.nav')}>
      <ul class="flex flex-col gap-1">
        {mainNav(locale, showWork).map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <a href={`mailto:${CONTACT_EMAIL}`} class="inline-block py-1 wrap-anywhere">
        {CONTACT_EMAIL}
      </a>
      <ul aria-label={t('footer.social')} class="mt-3 -ml-3 flex gap-1">
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              aria-label={social.name}
              class="flex size-11 items-center justify-center rounded-base text-muted hover:text-accent"
            >
              <Icon name={social.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>

  <div class="border-t border-border">
    <Container class="flex flex-col gap-2 py-6 text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>
        © 2020–{new Date().getFullYear()} {LEGAL_NAME} {t('footer.rights')}
      </p>
      <ul class="flex gap-4">
        <li>
          <a href={localizedPath(locale, '/privacy/')} class={linkClass}>
            {t('footer.privacy')}
          </a>
        </li>
        <li>
          <a href={localizedPath(locale, '/terms/')} class={linkClass}>
            {t('footer.terms')}
          </a>
        </li>
      </ul>
    </Container>
  </div>
</footer>
