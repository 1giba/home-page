---
// How an engagement starts (SPEC §5.2): intro call → scoping → proposal. Factual content only
// (Q-9): the 30-minute call is confirmed (B6); no durations, cadence or prices (Q-2).
import type { Locale } from '@/i18n/locales'
import { useTranslations } from '@/i18n/ui'

export interface Props {
  locale: Locale
  headingLevel?: 'h3' | 'h4'
}
const { locale, headingLevel: Heading = 'h3' } = Astro.props
const t = useTranslations(locale)
const steps = ['call', 'scope', 'proposal'] as const
---

<ol class="grid gap-6 md:grid-cols-3">
  {steps.map((step, i) => (
    <li class="rounded-base border border-border p-5">
      <Heading class="font-semibold">
        <span class="mr-2 font-mono text-sm text-muted" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        {t(`steps.${step}.title`)}
      </Heading>
      <p class="mt-2 text-muted">{t(`steps.${step}.text`)}</p>
    </li>
  ))}
</ol>
