---
// Home-page evidence while no case study is published (SPEC §4.5): the founder's confirmed
// background (B5), in chronological order, and that engagements are led by the founder (B3).
import type { Locale } from '@/i18n/locales'
import { localizedPath } from '@/i18n/paths'
import { useTranslations } from '@/i18n/ui'

export interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
const facts = ['2004', '2010', '2020', '2022', 'now'] as const
---

<p class="max-w-prose text-lg">{t('home.evidence.lead')}</p>
<ol class="mt-8 max-w-prose border-l border-border">
  {facts.map((year) => (
    <li data-year={year} class="relative pb-6 pl-6 last:pb-0">
      <span class="absolute top-2 -left-1.25 size-2.5 rounded-full bg-accent" aria-hidden="true" />
      <span class="font-mono text-sm text-muted">{t(`founder.${year}.label`)}</span>
      <p class="mt-1">{t(`founder.${year}`)}</p>
    </li>
  ))}
</ol>
<p class="mt-8">
  <a href={localizedPath(locale, '/about/')} class="inline-block py-1">
    {t('home.evidence.more')}
  </a>
</p>
