---
// Plain links, no JS (SPEC §8.4): each points to the same page in that language (or its home
// outside the locale tree). Each shows a flag and a short code (PT, EN); its accessible name adds
// the language's full name, in that language. The current language is marked with aria-current
// and, visually, a filled tile with a border (not colour alone).
import Flag from '@/components/ui/Flag.astro'
import { LANG_TAG, LOCALE_FULL_NAME, LOCALE_SHORT, LOCALES, type Locale } from '@/i18n/locales'
import { switchLocalePath } from '@/i18n/paths'
import { useTranslations } from '@/i18n/ui'

export interface Props {
  locale: Locale
  class?: string
}
const { locale, class: className } = Astro.props
const t = useTranslations(locale)
---

<ul
  data-lang-switch
  aria-label={t('lang.label')}
  class:list={['flex w-fit flex-wrap items-center gap-1 text-sm', className]}
>
  {LOCALES.map((target) => (
    <li>
      <a
        href={switchLocalePath(Astro.url.pathname, target)}
        lang={LANG_TAG[target]}
        hreflang={LANG_TAG[target]}
        aria-current={target === locale ? 'true' : undefined}
        class:list={[
          'inline-flex min-h-11 items-center gap-2 rounded-base border-2 px-2.5 font-semibold no-underline',
          target === locale
            ? 'border-accent bg-pale text-text hover:text-text'
            : 'border-transparent text-muted hover:border-border hover:text-text',
        ]}
      >
        <Flag locale={target} />
        {LOCALE_SHORT[target]}
        <span class="sr-only">{` – ${LOCALE_FULL_NAME[target]}`}</span>
      </a>
    </li>
  ))}
</ul>
