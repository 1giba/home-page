---
// Temporary page body for the F2 route skeleton: layout, SEO head and the page's H1. F4 replaces
// each use with real content; delete this component when the last page stops using it.
import Container from '@/components/ui/Container.astro'
import BaseLayout, { type Props as BaseLayoutProps } from '@/layouts/BaseLayout.astro'

export type Props = BaseLayoutProps & { heading: string }

const { heading, ...layout } = Astro.props
---

<BaseLayout {...layout}>
  <Container class="py-16">
    <h1 class="text-3xl font-semibold tracking-tight">{heading}</h1>
  </Container>
</BaseLayout>
