---
// Privacy and Terms (SPEC §2.9): content from the legal collection, a localized "last updated"
// date, and a contact line for questions (replaces the legacy hard-coded Portuguese, SPEC §2.6).
import { render } from 'astro:content'
import Prose from '@/components/Prose.astro'
import Container from '@/components/ui/Container.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Locale } from '@/i18n/locales'
import { localizedPath } from '@/i18n/paths'
import { formatDate, useTranslations } from '@/i18n/ui'
import { getLegal } from '@/lib/content'

export interface Props {
  locale: Locale
  id: 'privacy' | 'terms'
}
const { locale, id } = Astro.props
const t = useTranslations(locale)
const entry = await getLegal(id, locale)
if (!entry) throw new Error(`Missing content: src/content/legal/${id}/${locale}.md`)
const { Content } = await render(entry)
---

<BaseLayout
  locale={locale}
  path={`/${id}/`}
  title={t(`meta.${id}.title`)}
  description={t(`meta.${id}.description`)}
>
  <Container class="py-16">
    <h1 class="text-3xl font-semibold tracking-tight">{entry.data.title}</h1>
    <p class="mt-3 text-lg text-muted">{entry.data.subtitle}</p>
    <p class="mt-2 text-sm text-muted">
      {t('legal.updated')}
      <time datetime={entry.data.updated.toISOString().slice(0, 10)}>
        {formatDate(locale, entry.data.updated)}
      </time>
    </p>
    <div class="mt-10">
      <Prose>
        <Content />
      </Prose>
    </div>
    <section data-section="questions" class="mt-16 max-w-prose border-t border-border pt-8">
      <p>
        {t(`legal.questions.${id}`)}
        <a href={localizedPath(locale, '/contact/')}>{t('legal.contact')}</a>
      </p>
    </section>
  </Container>
</BaseLayout>
