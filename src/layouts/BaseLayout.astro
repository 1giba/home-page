---
import '@/styles/global.css'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import { LANG_TAG, type Locale } from '@/i18n/locales'
import { useTranslations } from '@/i18n/ui'

export interface Props {
  locale: Locale
  title: string
  /** Shows the Work nav item; F3 passes whether a case study is published (SPEC §4.5). */
  showWork?: boolean
}

const { locale, title, showWork = false } = Astro.props
const t = useTranslations(locale)
---

<!doctype html>
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-20 focus:rounded-base focus:bg-bg focus:px-4 focus:py-2"
    >
      {t('skip')}
    </a>
    <Header locale={locale} showWork={showWork} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer locale={locale} showWork={showWork} />
  </body>
</html>
